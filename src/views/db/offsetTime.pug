.form-row.align-items-center
    .col-2.text-right.d-flex.align-items-center.justify-content-end(style="font-size: initial;")
        | Offset Start Time by
    .col-2
        input.form-control(type='text', name="offsetTime_display", id="offsetTime_display", readonly)
    .col-2
        form#form_OffsetPlus_Button(method='POST' action='/admin/offsetPlus' style="margin: 0;")
            button.btn.btn-dark.w-100(type='submit', name="offsetPlus", id="offsetPlus") ➕ Plus
    .col-2
        form#form_OffsetMinus_Button(method='POST' action='/admin/offsetMinus' style="margin: 0;")
            button.btn.btn-dark.w-100(type='submit', name="offsetMinus", id="offsetMinus") ➖ Minus
    .col-2
        form#form_OffsetReset_Button(method='POST' action='/admin/offsetReset' style="margin: 0;")
            button.btn.btn-dark.w-100(type='submit', name="offsetReset", id="offsetReset") 🔄 Reset
    .col-1.text-right.d-flex.align-items-center.justify-content-end(style="font-size: initial;")
        | Auto Reset
    .col-1
        input.form-control(type='checkbox', value=true, name="checkbox_autoReset", id="checkbox_autoReset")

