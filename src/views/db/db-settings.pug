// db-settings
.row
    .col-12
        form(method='POST' action='/admin/submitSettings')
            button.btn.btn-primary.btn-block() SAVE
            button.btn.btn-primary.btn-block(type="reset",name="forceReload", id="forceReload") Force Reload On All Views
            .form-row
            -var i =0;
            .col-12.bg-dark
                h3 timeSettings
            each val, index in settings.timeSettings
                .form-row.row-cols-2
                    .col-9
                        .input-group
                            span.input-group-text(name="timeSettings " + index, id=index, style="width:100%")= index
                    .col-3
                            input.form-control(type='number', value=val, name="timeSettings " + index, id=index)
                -i++
            .col-12.bg-dark
                h3 Color
            // Explicit pickers for Admin background and header/footer
            .form-row.row-cols-2
                .col-9
                    .input-group
                        span.input-group-text(style="width:100%") Background
                .col-3
                    input.form-control(type='color', value=(settings && settings.Color && (settings.Color.Background || settings.Color.background || settings.Color.bg || settings.Color.bgColor) || '#2b2b2b'), name="Color Background", id="Background")
            .form-row.row-cols-2
                .col-9
                    .input-group
                        span.input-group-text(style="width:100%") Header/Footer
                .col-3
                    input.form-control(type='color', value=(settings && settings.Color && (settings.Color.HeaderFooter || settings.Color.headerFooter || settings.Color.accent || settings.Color.headerBG || settings.Color.footerBG) || '#3b3b3b'), name="Color HeaderFooter", id="HeaderFooter")
            // Other color settings
            each val, index in settings.Color
                if index !== 'Background' && index !== 'HeaderFooter'
                .form-row.row-cols-2
                    .col-9
                        .input-group
                            span.input-group-text(name="Color " + index + i, id=index, style="width:100%")= index
                    .col-3
                            input.form-control(type='color', value=val, name="Color " + index, id=index)
                -i++
            .col-12.bg-dark
                h3 MIDI
            each val, index in settings.MIDI
                .form-row.row-cols-2
                    .col-9
                        .input-group
                            span.input-group-text(name="MIDI " + index, id=index, style="width:100%")= index
                    .col-3
                        if index == "midi_interface_ID"
                            select.form-control(type='select',name="MIDI " +index,id=index,)
                                
                                each val, key in midi_interface_ID
                                    if key === settings.MIDI.midi_interface_ID
                                        option(selected='')= key

                                    else 
                                            option= key

                                
                        else
                            input.form-control(type='number', value=val, name="MIDI " +index, id=index)
                -i++
            .col-12.bg-dark
                h3 ARTNET
            each val, index in settings.ARTNET
                .form-row.row-cols-2
                    .col-9
                        .input-group
                            span.input-group-text(name="ARTNET " +index, id=index, style="width:100%")= index
                    .col-3
                            input.form-control(type='number', value=val, name="ARTNET " +index, id=index)
                -i++
